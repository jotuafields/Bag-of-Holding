rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function app()       { return get(/databases/$(database)/documents/settings/app).data; }
    function appExists() { return exists(/databases/$(database)/documents/settings/app); }
    function isDM()      { return signedIn() && appExists() && app().dm == request.auth.uid; }
    function member()    { return isDM() || (signedIn() && appExists()
                             && request.auth.token.email.lower() in app().emails); }

    // Campaign settings. The first person to sign in claims the DM seat.
    match /settings/app {
      allow read:   if signedIn();
      allow create: if signedIn() && !appExists() && request.resource.data.dm == request.auth.uid;
      allow update, delete: if isDM();
    }
    match /settings/{doc} {
      allow read:  if member();
      allow write: if isDM();
    }

    // Character sheets: everyone in the campaign can read, only the owner or DM can write.
    match /characters/{id} {
      allow read:   if member();
      allow create: if member() && (request.resource.data.owner == request.auth.uid || isDM());
      allow update: if member() && (resource.data.owner == '' || resource.data.owner == null
                       || resource.data.owner == request.auth.uid || isDM());
      allow delete: if isDM() || (member() && resource.data.owner == request.auth.uid);
    }

    // Dice rolls are public to the table and can't be edited after the fact.
    match /rolls/{id} {
      allow read:   if member();
      allow create: if member() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isDM();
    }

    // Whispers: readable only by the people listed in the whisper's audience.
    match /whispers/{id} {
      allow read:   if member() && request.auth.uid in resource.data.audience;
      allow create: if member() && request.auth.uid in request.resource.data.audience;
      allow update: if member() && request.auth.uid in resource.data.audience;
      allow delete: if isDM();
    }

    // Whisper senders (trickster gods, NPCs) are set up by the DM.
    match /personas/{id} {
      allow read:  if member();
      allow write: if isDM();
    }
  }
}
